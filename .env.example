# Project Configuration
# This file contains all environment variables needed for the application.
# Copy this file to .env and replace the placeholder values with actual values.

# ============================================================================
# Project Identity
# ============================================================================

# Project name (lowercase, alphanumeric, hyphens only)
# Used for container names, service identification, and resource naming
PROJECT_NAME=test-devscaffolding

# ============================================================================
# Domain and SSL Configuration
# ============================================================================

# Primary domain for the application
# Used by Traefik for routing and SSL certificate generation
DOMAIN=test.example.com

# Email address for Let's Encrypt ACME registration
# Used for SSL certificate notifications and account recovery
ACME_EMAIL=test@example.com

# URL base path for subpath deployment
# Application will be accessible at https://test.example.com/test-devscaffolding
# Leave empty for root-level deployment
BASE_PATH=/test-devscaffolding
# ============================================================================
# Security Secrets
# ============================================================================

# Secret key for session encryption and signing
# IMPORTANT: Must be at least 32 characters long
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=SL3jL_5pf7HDpIBIWy1MCLhIVobI-_WuxtR71_NLN2Y

# PostgreSQL database password
# IMPORTANT: Must be at least 16 characters long
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=8HoPI12Zxw_IolNCtC30mcdBaqidheIc

# ============================================================================
# Database Configuration
# ============================================================================

# PostgreSQL database name
POSTGRES_DB=test-devscaffolding_db

# PostgreSQL user
POSTGRES_USER=test-devscaffolding_user

# Database connection URL for backend service
# Connects through PgBouncer for connection pooling
DATABASE_URL=postgresql://test-devscaffolding_user:8HoPI12Zxw_IolNCtC30mcdBaqidheIc@pgbouncer:6432/test-devscaffolding_db

# Direct PostgreSQL connection (for migrations and admin tasks)
POSTGRES_URL=postgresql://test-devscaffolding_user:8HoPI12Zxw_IolNCtC30mcdBaqidheIc@postgres:5432/test-devscaffolding_db

# ============================================================================
# Redis Configuration
# ============================================================================

# Redis connection URL for session storage
REDIS_URL=redis://redis:6379/0

# ============================================================================
# Application Version Information
# ============================================================================

# Application version (Semantic Versioning)
# Updated during release process
APP_VERSION=0.1.0

# Git commit SHA
# Automatically set during build process
GIT_COMMIT=dev

# Build timestamp (ISO 8601 format)
# Automatically set during build process
BUILD_DATE=2025-11-19T21:50:07.698425

# ============================================================================
# Backend Configuration
# ============================================================================

# Backend API base URL (internal)
BACKEND_URL=http://backend:8000

# API version prefix
API_V1_PREFIX=/api/v1

# CORS allowed origins (comma-separated)
# For production, set to your frontend domain
CORS_ORIGINS=http://localhost:3000,https://test.example.com

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ============================================================================
# Frontend Configuration
# ============================================================================

# Public API URL (accessible from browser)
# Used by frontend to make API calls
NEXT_PUBLIC_API_URL=https://test.example.com/test-devscaffolding/api/v1

# Next.js base path for subpath deployment
NEXT_PUBLIC_BASE_PATH=/test-devscaffolding
# Next.js environment
NODE_ENV=production

# ============================================================================
# Traefik Configuration
# ============================================================================

# Traefik dashboard access (set to false in production)
TRAEFIK_DASHBOARD=false

# Traefik log level (DEBUG, INFO, WARN, ERROR)
TRAEFIK_LOG_LEVEL=INFO

# ============================================================================
# Monitoring Configuration (Optional)
# ============================================================================

# Enable Prometheus metrics collection
ENABLE_METRICS=true

# Prometheus retention period
PROMETHEUS_RETENTION=15d

# ============================================================================
# CI/CD Configuration
# ============================================================================

# Container registry for Docker images (optional)
# Supported: ghcr.io (GitHub), docker.io (Docker Hub), AWS ECR, Google GCR
# Example: ghcr.io/username, docker.io/username
# CONTAINER_REGISTRY=ghcr.io/username

# Container registry username (optional)
# Required if pushing images to a container registry
# CONTAINER_REGISTRY_USERNAME=your-username

# Container registry password/token (optional)
# Required if pushing images to a container registry
# For GitHub: Use a Personal Access Token with packages:write scope
# For Docker Hub: Use your Docker Hub password or access token
# CONTAINER_REGISTRY_PASSWORD=your-token

# Test coverage threshold (percentage)
# CI pipeline will fail if coverage falls below this threshold
COVERAGE_THRESHOLD=80

# Enable security scanning in CI (true/false)
# Scans dependencies and Docker images for vulnerabilities
ENABLE_SECURITY_SCAN=true

# Security scan severity threshold (LOW, MEDIUM, HIGH, CRITICAL)
# CI pipeline will fail if vulnerabilities at or above this level are found
SECURITY_SCAN_SEVERITY=HIGH

# ============================================================================
# Development Settings
# ============================================================================

# Enable debug mode (set to false in production)
DEBUG=false

# Enable hot reload for development
HOT_RELOAD=false

# Database connection pool settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Session configuration
SESSION_EXPIRE_SECONDS=3600
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax
